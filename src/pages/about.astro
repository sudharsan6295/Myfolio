---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

const [aboutEntry] = await getCollection("about");
if (!aboutEntry) {
  throw new Error(
    "No entry found in src/content/about/ — add about.md following the template in README.md.",
  );
}
const about = aboutEntry.data;
const { Content } = await render(aboutEntry);

// Jump-link targets. Derived rather than hardcoded so a section with no
// content never produces a link to an anchor that isn't on the page.
// "Background" is absent on purpose: the nav sits inside that section,
// so a link to it would point at where the reader already is.
const sections = [
  { id: "proud-of", label: "Proud of", show: about.highlights.length > 0 },
  { id: "how-i-work", label: "How I work", show: about.principles.length > 0 },
  { id: "experience", label: "Experience", show: about.experience.length > 0 },
].filter((s) => s.show);
---

<BaseLayout title="About Me" description={about.tagline}>
  <article class="mx-auto max-w-5xl px-6 pt-10 sm:pt-14 pb-8">
    <!-- ── Hero: the specimen plate ─────────────────────────────────── -->
    <section class="gx gx-hero" aria-labelledby="about-name">
      <div class="hero-grid">
        {about.photo && (
          <button
            type="button"
            id="about-photo-trigger"
            class="plate load-in"
            style="--d:0ms"
            aria-label={`View ${about.name}'s photo`}
          >
            <Image
              src={about.photo}
              alt={about.photoAlt ?? `${about.name}'s profile photo`}
              width={168}
              height={210}
              class="h-full w-full object-cover"
            />
          </button>
        )}

        <div class="hero-text">
          <p class="eyebrow load-in" style="--d:60ms">
            <span>About</span>
            <span class="eyebrow-rule" aria-hidden="true"></span>
          </p>

          <h1 id="about-name" class="hero-name load-in" style="--d:120ms">
            {about.name}
          </h1>

          <p class="hero-role load-in" style="--d:180ms">{about.role}</p>

          <ul class="hero-meta load-in" style="--d:240ms">
            {about.location && <li>{about.location}</li>}
            {about.email && (
              <li><a href={`mailto:${about.email}`}>{about.email}</a></li>
            )}
            {about.resumeUrl && (
              <li><a href={about.resumeUrl} class="u">Résumé</a></li>
            )}
          </ul>

          {about.stats.length > 0 && (
            <dl class="stats load-in" style="--d:300ms">
              {about.stats.map((stat) => (
                <div class="stat">
                  <dt class="stat-value">{stat.value}</dt>
                  <dd class="stat-label">{stat.label}</dd>
                </div>
              ))}
            </dl>
          )}

          {about.openTo.length > 0 && (
            <div class="load-in" style="--d:360ms">
              <p class="mini-label">Open to</p>
              <ul class="chips">
                {about.openTo.map((role) => (
                  <li class="chip chip-pen">{role}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Bio and the at-a-glance card share a row; everything below
         runs the full width of the page. -->
    <div class="body-grid">
      <div class="flex flex-col gap-6">
        <section id="background" class="gx gx-pad reveal">
          {sections.length > 0 && (
            <nav class="jump" aria-label="Jump to a section">
              <p class="mini-label">Jump to</p>
              <ul class="chips">
                {sections.map((s) => (
                  <li><a href={`#${s.id}`} class="chip jump-link">{s.label}</a></li>
                ))}
              </ul>
            </nav>
          )}

          <div class="prose max-w-none">
            <Content />
          </div>

          <p class="cta">
            Curious what this looks like in practice? The <a href="/projects">Workbench</a> has
            the prototypes, and <a href="/blog">Field Notes</a> has the writing behind
            the thinking.
          </p>
        </section>

        <!-- ── Highlights: the signature ──────────────────────────────── -->

      {about.highlights.length > 0 && (
        <section id="proud-of" class="gx gx-pad reveal" aria-labelledby="hl-h">
          <p id="hl-h" class="section-label">A few things I'm proud of</p>
          <ul class="hl-list">
            {about.highlights.map((item, i) => (
              <li class="hl" style={`--i:${i}`}>
                <span class="hl-bar" aria-hidden="true"></span>
                <p>{item}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- ── Principles ─────────────────────────────────────────────── -->

      {about.principles.length > 0 && (
        <section id="how-i-work" class="gx gx-pad reveal" aria-labelledby="pr-h">
          <p id="pr-h" class="section-label">How I approach delivery</p>
          <div class="pgrid">
            {about.principles.map((principle, i) => (
              <article class="pcard" style={`--i:${i}`}>
                <h3>{principle.title}</h3>
                <p>{principle.description}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- ── Experience ─────────────────────────────────────────────── -->

      {about.experience.length > 0 && (
        <section id="experience" class="gx gx-pad reveal" aria-labelledby="ex-h">
          <p id="ex-h" class="section-label">Work experience</p>
          <ol class="xp">
            {about.experience.map((role, i) => {
              // "Present" is the one value that changes how a row reads:
              // it gets a filled node and a live status chip, everything
              // else gets a hollow one. Read off the content, not hardcoded.
              const current = role.end.trim().toLowerCase() === "present";
              return (
                <li class="xp-item" style={`--i:${i}`}>
                  <span
                    class:list={["xp-node", current && "is-current"]}
                    aria-hidden="true"
                  ></span>

                  <div class="xp-head">
                    <p class="xp-co">
                      {role.company}{role.location ? ` · ${role.location}` : ""}
                    </p>
                    <span class:list={["xp-when", current && "is-current"]}>
                      {role.start} — {role.end}
                    </span>
                  </div>

                  <h3>{role.role}</h3>

                  {role.bullets.length > 0 && (
                    <ul class="xp-bullets">
                      {role.bullets.map((bullet) => (
                        <li><span aria-hidden="true">–</span><span>{bullet}</span></li>
                      ))}
                    </ul>
                  )}

                  {role.skills.length > 0 && (
                    <ul class="chips xp-skills" aria-label={`Skills used at ${role.company}`}>
                      {role.skills.map((skill) => <li class="chip">{skill}</li>)}
                    </ul>
                  )}
                </li>
              );
            })}
          </ol>
        </section>
      )}
      </div>

      <div class="spec-col">
        <aside class="gx spec reveal" aria-label="At a glance">
          {about.currently.length > 0 && (
            <div class="spec-block">
              <p class="mini-label">Currently</p>
              <ul class="spec-now">
                {about.currently.map((item) => <li>{item}</li>)}
              </ul>
              {about.currentlyUrl && (
                <a
                  href={about.currentlyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="spec-link"
                >
                  View course →
                </a>
              )}
            </div>
          )}

          {about.focusAreas.length > 0 && (
            <div class="spec-block">
              <p class="mini-label">Focus areas</p>
              <ul class="chips">
                {about.focusAreas.map((a) => <li class="chip chip-pen">{a}</li>)}
              </ul>
            </div>
          )}

          {about.tools.length > 0 && (
            <div class="spec-block">
              <p class="mini-label">Tools and technologies</p>
              <ul class="chips">
                {about.tools.map((t) => <li class="chip">{t}</li>)}
              </ul>
            </div>
          )}

          {about.certifications.length > 0 && (
            <div class="spec-block">
              <p class="mini-label">Certifications</p>
              <ul class="chips">
                {about.certifications.map((c) => <li class="chip chip-amber">{c}</li>)}
              </ul>
            </div>
          )}

          {about.education.length > 0 && (
            <div class="spec-block">
              <p class="mini-label">Education</p>
              <ul class="edu">
                {about.education.map((edu) => (
                  <li>
                    <p class="edu-degree">{edu.degree}</p>
                    <p class="edu-meta">{edu.institution} <span>·</span> {edu.year}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </div>
  </article>

  {about.photo && (
    <div
      id="about-photo-lightbox"
      class="hidden fixed inset-0 z-[100] items-center justify-center p-6"
      role="dialog"
      aria-modal="true"
      aria-label={`${about.name}'s photo`}
    >
      <div id="about-photo-lightbox-backdrop" class="absolute inset-0 bg-ink/70 backdrop-blur-sm"></div>
      <button
        type="button"
        id="about-photo-lightbox-close"
        class="absolute top-4 right-4 sm:top-6 sm:right-6 h-9 w-9 rounded-full bg-paper border border-line flex items-center justify-center text-ink hover:text-pen transition-colors z-10"
        aria-label="Close"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M2 2L14 14M14 2L2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
      <Image
        src={about.photo}
        alt={about.photoAlt ?? `${about.name}'s profile photo`}
        width={900}
        class="relative z-0 max-h-[85vh] max-w-[90vw] w-auto h-auto rounded-md border border-line shadow-2xl object-contain"
      />
    </div>
  )}

  <noscript>
    <style>
      /* The scroll reveal is a progressive enhancement. With no script to
         un-hide them, the panels must render as normal, not as a blank page. */
      .reveal { opacity: 1 !important; transform: none !important; }
    </style>
  </noscript>

  <style>
    /* ═══════════════════════════════════════════════════════════════════
     * About page layout. Surfaces use the same fill, border, radius and
     * shadow as global.css's .panel, so this page sits on the identical
     * background as every other page — the layout and motion are what
     * make it its own thing, not the material.
     * ═══════════════════════════════════════════════════════════════ */
    /* Identical to global.css's .panel — same fill, border, radius and
       shadow every other page uses. Kept as its own class only so the
       page's own layout rules have something to hang off. */
    .gx {
      position: relative;
      background: var(--color-paper-raised);
      border: 1px solid var(--color-line);
      border-radius: 8px;
      box-shadow: 0 1px 2px rgba(20, 22, 23, 0.05);
    }
    .gx-pad {
      padding: 1.75rem 1.5rem;
    }
    @media (min-width: 640px) {
      .gx-pad {
        padding: 2.25rem 2.5rem;
      }
    }

    /* ── Hero ──────────────────────────────────────────────────────── */
    .gx-hero {
      padding: 1.75rem 1.5rem;
      overflow: hidden;
    }
    @media (min-width: 640px) {
      .gx-hero {
        padding: 2.5rem 2.5rem;
      }
    }
    .hero-grid {
      display: flex;
      gap: 1.5rem;
      align-items: flex-start;
    }
    @media (min-width: 640px) {
      .hero-grid {
        gap: 2rem;
      }
    }
    .hero-text {
      min-width: 0;
      flex: 1;
    }

    /* The photo as a specimen plate: a real pane, with a glare streak. */
    .plate {
      position: relative;
      flex-shrink: 0;
      width: 84px;
      height: 105px;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid var(--color-line);
      box-shadow: 0 1px 2px rgba(20, 22, 23, 0.05);
      cursor: zoom-in;
      transition:
        transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
        border-color 0.25s ease;
    }
    @media (min-width: 640px) {
      .plate {
        width: 132px;
        height: 165px;
      }
    }
    .plate:hover,
    .plate:focus-visible {
      transform: translateY(-3px);
      border-color: var(--color-pen);
    }
    .eyebrow {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--color-pen);
      margin-bottom: 0.85rem;
    }
    .eyebrow-rule {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, var(--color-line), transparent);
    }

    .hero-name {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(1.85rem, 6.2vw, 3.35rem);
      line-height: 1.04;
      letter-spacing: -0.022em;
      color: var(--color-ink);
      text-wrap: balance;
    }
    .hero-role {
      margin-top: 0.7rem;
      font-size: 1.02rem;
      line-height: 1.5;
      color: var(--color-ink-soft);
      max-width: 46ch;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 1.1rem;
      margin-top: 1.25rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--color-ink-soft);
    }
    .hero-meta a {
      color: inherit;
      transition: color 0.2s ease;
    }
    .hero-meta a:hover {
      color: var(--color-pen);
    }
    .hero-meta .u {
      text-decoration: underline;
      text-decoration-color: var(--color-line);
      text-underline-offset: 4px;
    }

    /* Sits at the top of the Background panel, above the prose. */
    .jump {
      margin-bottom: 1.75rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--color-line);
    }
    /* The chip is the anchor, so the whole tag is the hit target. */
    .jump-link {
      display: inline-block;
      color: var(--color-ink-soft);
      transition:
        color 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
    }
    .jump-link:hover,
    .jump-link:focus-visible {
      color: var(--color-pen);
      border-color: color-mix(in srgb, var(--color-pen) 45%, var(--color-line));
    }
    /* Clear the sticky header when an anchor is jumped to, or the
       section heading lands underneath it. */
    .body-grid section[id] {
      scroll-margin-top: 5.5rem;
    }

    /* Headline figures. A rule above each one rather than a box around
       it — the page has enough panels already, and the numbers read
       better as a measured strip than as four more cards. */
    .stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 1.5rem;
      margin-top: 1.5rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--color-line);
    }
    @media (min-width: 640px) {
      .stats {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }
    .stat-value {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.5rem;
      line-height: 1.1;
      letter-spacing: -0.015em;
      color: var(--color-pen);
    }
    .stat-label {
      margin-top: 0.3rem;
      font-family: var(--font-mono);
      font-size: 0.6rem;
      line-height: 1.45;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-ink-soft);
    }

    .mini-label {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--color-ink-soft);
      margin-bottom: 0.6rem;
    }
    .stats + div,
    .hero-meta + div {
      margin-top: 1.4rem;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .chip {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      line-height: 1.5;
      padding: 0.15rem 0.5rem;
      border-radius: 3px;
      border: 1px solid var(--color-line);
      color: var(--color-ink-soft);
      background: var(--color-paper);
      transition:
        border-color 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
    }
    .chip:hover {
      transform: translateY(-1px);
    }
    .chip-pen {
      color: var(--color-pen);
      border-color: color-mix(in srgb, var(--color-pen) 38%, transparent);
    }
    .chip-pen:hover {
      border-color: var(--color-pen);
    }
    .chip-amber {
      color: var(--color-highlight);
      border-color: color-mix(in srgb, var(--color-highlight) 40%, transparent);
    }
    .chip-amber:hover {
      border-color: var(--color-highlight);
    }

    /* ── Body layout ───────────────────────────────────────────────── */
    .body-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-top: 1.5rem;
    }
    @media (min-width: 1024px) {
      .body-grid {
        grid-template-columns: 1fr 290px;
      }
    }
    .spec-col {
      min-width: 0;
    }
    @media (min-width: 1024px) {
      .spec-col > .spec {
        position: sticky;
        top: 6rem;
      }
    }

    .section-label {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--color-ink-soft);
      padding-bottom: 0.6rem;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--color-line);
    }

    .cta {
      margin-top: 1.75rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--color-line);
      font-size: 0.875rem;
      line-height: 1.7;
      color: var(--color-ink-soft);
    }
    .cta a {
      color: var(--color-pen);
      text-decoration: underline;
      text-decoration-color: var(--color-line);
      text-underline-offset: 4px;
      transition: text-decoration-color 0.2s ease;
    }
    .cta a:hover {
      text-decoration-color: var(--color-pen);
    }

    /* ── Highlights: a lit margin bar per line ─────────────────────── */
    .hl-list {
      display: flex;
      flex-direction: column;
      gap: 1.05rem;
    }
    .hl {
      display: flex;
      gap: 1rem;
      align-items: stretch;
    }
    .hl p {
      font-size: 0.9rem;
      line-height: 1.62;
      color: var(--color-ink);
    }
    .hl-bar {
      flex-shrink: 0;
      width: 2px;
      border-radius: 2px;
      background: linear-gradient(
        180deg,
        var(--color-pen),
        color-mix(in srgb, var(--color-pen) 22%, transparent)
      );
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
      transition-delay: calc(var(--i) * 90ms + 120ms);
    }
    .reveal.is-in .hl-bar {
      transform: scaleY(1);
    }

    /* ── Principles: the site's card-edge motif, drawn in on hover ─── */
    .pgrid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    @media (min-width: 640px) {
      .pgrid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    .pcard {
      position: relative;
      overflow: hidden;
      padding: 1.1rem 1.15rem;
      border: 1px solid var(--color-line);
      border-radius: 8px;
      background: var(--color-paper);
      transition:
        transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
        border-color 0.25s ease;
    }
    /* Same "this one's flagged" device PostCard/ProjectCard use — a
       colored top edge, here drawn in from the left on hover. */
    .pcard::after {
      content: "";
      position: absolute;
      inset: 0 0 auto 0;
      height: 2px;
      background: var(--color-pen);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
      pointer-events: none;
    }
    .pcard:hover,
    .pcard:focus-within {
      transform: translateY(-2px);
      border-color: color-mix(in srgb, var(--color-pen) 45%, var(--color-line));
    }
    .pcard:hover::after,
    .pcard:focus-within::after {
      transform: scaleX(1);
    }
    .pcard h3 {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 0.98rem;
      line-height: 1.3;
      color: var(--color-ink);
      margin-bottom: 0.45rem;
    }
    .pcard p {
      font-size: 0.82rem;
      line-height: 1.6;
      color: var(--color-ink-soft);
    }

    /* ── Experience ─────────────────────────────────────────────────
       These roles are a real progression — system engineer to senior
       analyst to lead consultant — so the order carries information and
       a continuous rail is the honest device for it. The company leads
       each entry as a mono eyebrow (that's what a reader scans for), the
       dates sit right as a chip, and the role title gets the full width. */
    .xp {
      display: flex;
      flex-direction: column;
    }
    .xp-item {
      position: relative;
      padding: 0 0 2rem 1.6rem;
    }
    .xp-item:last-child {
      padding-bottom: 0;
    }
    /* One continuous rail, drawn per item so it stops at the last node. */
    .xp-item::before {
      content: "";
      position: absolute;
      left: 3px;
      top: 1.2rem;
      bottom: 0;
      width: 1px;
      background: var(--color-line);
    }
    /* The rail runs through the last entry too, down to the end of its
       content — stopping it at the second-to-last node left the final
       role visually detached from the timeline. */
    .xp-node {
      position: absolute;
      left: 0;
      top: 0.45rem;
      width: 7px;
      height: 7px;
      border-radius: 2px;
      background: var(--color-paper-raised);
      border: 1px solid var(--color-pen);
      transform: scale(0);
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      transition-delay: calc(var(--i) * 110ms + 150ms);
    }
    /* Filled = the role held now. Hollow = finished. */
    .xp-node.is-current {
      background: var(--color-pen);
    }
    .reveal.is-in .xp-node {
      transform: scale(1);
    }

    .xp-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.3rem 0.9rem;
      margin-bottom: 0.35rem;
    }
    .xp-co {
      font-family: var(--font-mono);
      font-size: 0.67rem;
      text-transform: uppercase;
      letter-spacing: 0.11em;
      color: var(--color-ink-soft);
    }
    .xp-when {
      flex-shrink: 0;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      white-space: nowrap;
      color: var(--color-ink-soft);
      background: var(--color-paper);
      border: 1px solid var(--color-line);
      border-radius: 3px;
      padding: 0.08rem 0.45rem;
    }
    .xp-when.is-current {
      color: var(--color-pen);
      border-color: color-mix(in srgb, var(--color-pen) 40%, transparent);
    }

    .xp h3 {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.05rem;
      line-height: 1.35;
      color: var(--color-ink);
      margin-bottom: 0.75rem;
    }
    .xp-bullets {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }
    .xp-bullets li {
      display: flex;
      gap: 0.5rem;
      font-size: 0.86rem;
      line-height: 1.62;
      color: var(--color-ink);
    }
    /* Reuses .chips/.chip from the spec card so a skill tag looks the
       same wherever it appears on the page. */
    .xp-skills {
      margin-top: 0.9rem;
    }
    .xp-bullets li > span:first-child {
      flex-shrink: 0;
      font-family: var(--font-mono);
      color: var(--color-pen-soft);
    }

    /* ── Spec card ─────────────────────────────────────────────────── */
    .spec {
      padding: 1.4rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
    }
    .spec-block + .spec-block {
      padding-top: 1.4rem;
      border-top: 1px solid var(--color-line);
    }
    .spec-now {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      font-size: 0.84rem;
      line-height: 1.55;
      color: var(--color-ink);
    }
    .spec-link {
      display: inline-block;
      margin-top: 0.6rem;
      font-family: var(--font-mono);
      font-size: 0.66rem;
      text-transform: uppercase;
      letter-spacing: 0.11em;
      color: var(--color-pen);
      transition: color 0.2s ease;
    }
    .spec-link:hover {
      color: var(--color-ink);
    }
    .edu {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .edu-degree {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 0.85rem;
      line-height: 1.35;
      color: var(--color-ink);
    }
    .edu-meta {
      margin-top: 0.2rem;
      font-family: var(--font-mono);
      font-size: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--color-ink-soft);
    }
    .edu-meta span {
      color: var(--color-highlight);
    }

    /* ── Motion ────────────────────────────────────────────────────── */
    .load-in {
      opacity: 0;
      transform: translateY(10px);
      animation: rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
      animation-delay: var(--d, 0ms);
    }
    @keyframes rise {
      to {
        opacity: 1;
        transform: none;
      }
    }
    .reveal {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.6s ease,
        transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .reveal.is-in {
      opacity: 1;
      transform: none;
    }
    /* Shown without animating — used when nobody can see the animation
       anyway (hidden tab, reduced motion) or when the observer failed.
       Without this, a page loaded in a background tab sits mid-transition
       until the tab is focused, because the animation clock is paused. */
    .reveal.no-anim,
    .reveal.no-anim .hl-bar,
    .reveal.no-anim .xp-node {
      transition: none;
    }

    /* Quality floor: nothing above is load-bearing for reading the page. */
    @media (prefers-reduced-motion: reduce) {
      .load-in,
      .reveal {
        opacity: 1;
        transform: none;
        animation: none;
        transition: none;
      }
      .hl-bar,
      .xp-node {
        transform: none;
        transition: none;
      }
      .plate,
      .pcard {
        transition: none;
      }
      .plate:hover .plate-glare,
      .plate:focus-visible .plate-glare,
      .pcard:hover::after {
        animation: none;
      }
    }
  </style>

  <script>
    // Two things live here: the photo lightbox (unchanged mechanics, moved
    // from Nav.astro long ago) and the scroll-reveal for the panels.
    //
    // Both follow this project's View Transitions rule: anything that
    // queries page DOM is re-run inside astro:page-load (the router
    // replaces this page's DOM on every soft navigation), while listeners
    // on `document` itself are attached exactly once. The `let` bindings
    // below are reassigned on each page-load so the once-attached Escape
    // handler always closes over the lightbox currently in the DOM.
    let trigger: HTMLElement | null;
    let lightbox: HTMLElement | null;
    let revealObserver: IntersectionObserver | null = null;

    function openLightbox() {
      if (!lightbox) return;
      const closeBtn = document.getElementById("about-photo-lightbox-close");
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
      closeBtn?.focus();
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = "";
      trigger?.focus();
    }

    function initAboutPage() {
      trigger = document.getElementById("about-photo-trigger");
      lightbox = document.getElementById("about-photo-lightbox");
      const backdrop = document.getElementById("about-photo-lightbox-backdrop");
      const closeBtn = document.getElementById("about-photo-lightbox-close");

      trigger?.addEventListener("click", openLightbox);
      backdrop?.addEventListener("click", closeLightbox);
      closeBtn?.addEventListener("click", closeLightbox);

      // Scroll reveal. Disconnect any observer from a previous visit first —
      // it holds references to elements the router has already thrown away.
      revealObserver?.disconnect();
      revealObserver = null;

      const panels = document.querySelectorAll<HTMLElement>(".reveal");
      if (!panels.length) return;

      const revealAll = () =>
        panels.forEach((el) => el.classList.add("no-anim", "is-in"));

      if (
        !("IntersectionObserver" in window) ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
        document.hidden
      ) {
        // No observer, no motion wanted, or nobody watching — just show it.
        revealAll();
        return;
      }

      revealObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-in");
            obs.unobserve(entry.target); // reveal once, not on every pass
          });
        },
        { rootMargin: "0px 0px -12% 0px", threshold: 0.06 },
      );

      panels.forEach((el) => revealObserver!.observe(el));

      // If the observer has not revealed a single panel shortly after load,
      // it is not working in this context — fall back to showing everything.
      // Checking for *zero* reveals (rather than a per-element timeout) keeps
      // the scroll animation intact whenever the observer does work.
      window.setTimeout(() => {
        if (!document.querySelector(".reveal.is-in")) revealAll();
      }, 1200);
    }

    document.addEventListener("astro:page-load", initAboutPage);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && lightbox && !lightbox.classList.contains("hidden")) {
        closeLightbox();
      }
    });
  </script>
</BaseLayout>
