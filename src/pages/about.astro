---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

const [aboutEntry] = await getCollection("about");
if (!aboutEntry) {
  throw new Error(
    "No entry found in src/content/about/ — add about.md following the template in README.md.",
  );
}
const about = aboutEntry.data;
const { Content } = await render(aboutEntry);
---

<BaseLayout title="About Me" description={about.tagline}>
  <article class="mx-auto max-w-5xl px-6 pt-10 sm:pt-14 pb-8">
    <!-- Intro + at-a-glance -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-6 lg:gap-8">
      <div class="glass rounded-3xl p-8 sm:p-12 relative">
        {about.photo && (
          <button
            type="button"
            id="about-photo-trigger"
            class="hidden sm:block absolute top-7 right-7 sm:top-9 sm:right-9 w-[92px] h-[120px] rounded-md overflow-hidden border-2 border-line shadow-sm cursor-zoom-in hover:border-pen transition-colors"
            aria-label={`View ${about.name}'s photo`}
          >
            <Image
              src={about.photo}
              alt={about.photoAlt ?? `${about.name}'s profile photo`}
              width={92}
              height={120}
              class="h-full w-full object-cover"
            />
          </button>
        )}
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-pen mb-4">About Me</p>
        <h1 class="font-display font-normal text-4xl sm:text-[3.25rem] leading-[1.1] tracking-[-0.01em] text-ink text-balance">
          {about.name}
        </h1>
        <p class="mt-3 text-lg text-ink-soft">{about.role}</p>

        <div class="prose mt-8 max-w-none">
          <Content />
        </div>

        {about.highlights.length > 0 && (
          <div class="mt-8 pt-7 border-t border-line">
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft mb-4">
              A few things I'm proud of
            </p>
            <ul class="flex flex-col gap-2.5">
              {about.highlights.map((item) => (
                <li class="flex items-start gap-2.5">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="shrink-0 mt-1 text-pen">
                    <path d="M3.5 8.4L6.4 11.3L12.5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <p class="text-sm text-ink leading-snug">{item}</p>
                </li>
              ))}
            </ul>
          </div>
        )}

        <p class="mt-6 pt-6 border-t border-line text-sm text-ink-soft leading-relaxed">
          Curious what this looks like in practice? The <a href="/projects" class="text-pen underline decoration-line hover:decoration-pen underline-offset-4">Workbench</a> has
          real prototypes, and <a href="/blog" class="text-pen underline decoration-line hover:decoration-pen underline-offset-4">Field Notes</a> has
          the writing behind the thinking. If you're evaluating me for a role
          or just want to talk shop, the fastest way to reach me is the email
          in the panel alongside this.
        </p>
      </div>

      <aside aria-label="At a glance" class="glass rounded-3xl p-6 flex flex-col gap-6">
        {about.openTo.length > 0 && (
          <div>
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft mb-2">Open to</p>
            <ul class="flex flex-wrap gap-1.5">
              {about.openTo.map((role) => (
                <li class="font-mono text-[0.65rem] text-pen border border-pen/40 rounded-[3px] px-2 py-0.5 bg-pen/5">
                  {role}
                </li>
              ))}
            </ul>
          </div>
        )}

        <div>
          <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft mb-3 border-b border-line pb-2">
            At a glance
          </p>
          <ul class="space-y-1.5 font-mono text-xs text-ink-soft">
            {about.location && <li>{about.location}</li>}
            {about.email && (
              <li><a href={`mailto:${about.email}`} class="hover:text-pen transition-colors">{about.email}</a></li>
            )}
            {about.resumeUrl && (
              <li><a href={about.resumeUrl} class="hover:text-pen transition-colors underline decoration-line underline-offset-4">Download résumé</a></li>
            )}
            {about.social.linkedin && (
              <li>
                <a href={about.social.linkedin} class="hover:text-pen transition-colors" target="_blank" rel="noopener noreferrer">
                  LinkedIn ↗
                </a>
              </li>
            )}
            {about.social.github && (
              <li>
                <a href={about.social.github} class="hover:text-pen transition-colors" target="_blank" rel="noopener noreferrer">
                  GitHub ↗
                </a>
              </li>
            )}
          </ul>
        </div>

        {about.currently && (
          <div>
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft mb-2">Currently</p>
            <p class="text-sm text-ink leading-relaxed">{about.currently}</p>
          </div>
        )}

        {about.focusAreas.length > 0 && (
          <div>
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft mb-2">Focus areas</p>
            <ul class="flex flex-wrap gap-1.5">
              {about.focusAreas.map((area) => (
                <li class="font-mono text-[0.65rem] text-pen border border-pen/30 rounded-[3px] px-2 py-0.5 bg-paper/50">
                  {area}
                </li>
              ))}
            </ul>
          </div>
        )}

        {about.tools.length > 0 && (
          <div>
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft mb-2">Tools and Technologies</p>
            <ul class="flex flex-wrap gap-1.5">
              {about.tools.map((tool) => (
                <li class="font-mono text-[0.65rem] text-ink-soft border border-line rounded-[3px] px-2 py-0.5 bg-paper/50">
                  {tool}
                </li>
              ))}
            </ul>
          </div>
        )}

        {about.certifications.length > 0 && (
          <div>
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft mb-2">Certifications</p>
            <ul class="flex flex-wrap gap-1.5">
              {about.certifications.map((cert) => (
                <li class="font-mono text-[0.65rem] text-highlight border border-highlight/40 rounded-[3px] px-2 py-0.5 bg-paper/50">
                  {cert}
                </li>
              ))}
            </ul>
          </div>
        )}

        {about.education.length > 0 && (
          <div>
            <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft mb-2">Education</p>
            <ul class="space-y-2.5">
              {about.education.map((edu) => (
                <li class="relative rounded-[3px] border border-line bg-paper/40 px-3 py-2.5">
                  <svg width="13" height="13" viewBox="0 0 16 16" fill="none" class="absolute top-2.5 right-2.5 text-highlight">
                    <path d="M8 2L14.5 5.2L8 8.4L1.5 5.2L8 2Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" />
                    <path d="M4 6.8V10c0 .9 1.8 1.8 4 1.8s4-.9 4-1.8V6.8" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
                    <path d="M14.5 5.2V10" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
                  </svg>
                  <p class="font-display text-sm text-ink leading-snug pr-5">{edu.degree}</p>
                  <p class="mt-1 font-mono text-[0.6rem] uppercase tracking-[0.08em] text-ink-soft">
                    {edu.institution} <span class="text-highlight">·</span> {edu.year}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>

    <!-- How I approach delivery -->
    {about.principles.length > 0 && (
      <div class="mt-6 glass rounded-3xl p-8 sm:p-10">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-ink-soft mb-6 border-b border-line pb-2">
          How I approach delivery
        </p>
        <div class="grid sm:grid-cols-3 gap-6 sm:gap-8">
          {about.principles.map((principle) => (
            <div>
              <h3 class="font-display text-lg text-ink mb-2">{principle.title}</h3>
              <p class="text-sm text-ink-soft leading-relaxed">{principle.description}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Work experience -->
    {about.experience.length > 0 && (
      <div class="mt-6 glass rounded-3xl p-8 sm:p-12">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-ink-soft mb-6 border-b border-line pb-2">
          Work experience
        </p>
        <ol class="space-y-10">
          {about.experience.map((role) => (
            <li class="grid sm:grid-cols-[140px_1fr] gap-2 sm:gap-6">
              <p class="font-mono text-xs text-ink-soft pt-1">
                {role.start} — {role.end}
              </p>
              <div>
                <h3 class="font-display text-lg text-ink">{role.role}</h3>
                <p class="text-sm text-ink-soft mb-3">
                  {role.company}{role.location ? ` · ${role.location}` : ""}
                </p>
                {role.bullets.length > 0 && (
                  <ul class="space-y-1.5">
                    {role.bullets.map((bullet) => (
                      <li class="text-sm text-ink leading-relaxed pl-4 relative before:content-['—'] before:absolute before:left-0 before:text-pen-soft">
                        {bullet}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    )}
  </article>

  {about.photo && (
    <div
      id="about-photo-lightbox"
      class="hidden fixed inset-0 z-[100] items-center justify-center p-6"
      role="dialog"
      aria-modal="true"
      aria-label={`${about.name}'s photo`}
    >
      <div id="about-photo-lightbox-backdrop" class="absolute inset-0 bg-ink/70 backdrop-blur-sm"></div>
      <button
        type="button"
        id="about-photo-lightbox-close"
        class="absolute top-4 right-4 sm:top-6 sm:right-6 h-9 w-9 rounded-full glass flex items-center justify-center text-ink hover:text-pen transition-colors z-10"
        aria-label="Close"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M2 2L14 14M14 2L2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
      <Image
        src={about.photo}
        alt={about.photoAlt ?? `${about.name}'s profile photo`}
        width={900}
        class="relative z-0 max-h-[85vh] max-w-[90vw] w-auto h-auto rounded-2xl border border-line shadow-2xl object-contain"
      />
    </div>
  )}

  <script>
    // Photo lightbox — moved here from Nav.astro (the nav's header circle
    // now shows the <Seal> monogram instead of the photo, so this is the
    // photo's only home now). Same open/close mechanics as before: click
    // the thumbnail to enlarge, click backdrop/✕/Escape to dismiss.
    //
    // `let` bindings re-queried inside astro:page-load (this page's own
    // DOM, replaced on every navigation with View Transitions) rather
    // than `const`s captured once — the Escape-key listener on `document`
    // below is attached exactly once (document itself is never replaced)
    // and closes over these bindings, so it always needs to see whichever
    // lightbox is currently in the DOM, not a stale one from a previous
    // visit to this page.
    let trigger: HTMLElement | null;
    let lightbox: HTMLElement | null;

    function openLightbox() {
      if (!lightbox) return;
      const closeBtn = document.getElementById("about-photo-lightbox-close");
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
      closeBtn?.focus();
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = "";
      trigger?.focus();
    }

    function initAboutPhoto() {
      trigger = document.getElementById("about-photo-trigger");
      lightbox = document.getElementById("about-photo-lightbox");
      const backdrop = document.getElementById("about-photo-lightbox-backdrop");
      const closeBtn = document.getElementById("about-photo-lightbox-close");

      trigger?.addEventListener("click", openLightbox);
      backdrop?.addEventListener("click", closeLightbox);
      closeBtn?.addEventListener("click", closeLightbox);
    }

    document.addEventListener("astro:page-load", initAboutPhoto);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && lightbox && !lightbox.classList.contains("hidden")) closeLightbox();
    });
  </script>
</BaseLayout>
