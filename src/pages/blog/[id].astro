---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatusChip from "../../components/StatusChip.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, coverImage, coverImageAlt } = post.data;
const { Content, headings } = await render(post);

// Table of contents — H2 sections only (every post's actual structure,
// confirmed across existing posts). Astro's markdown pipeline slugs
// headings by default (github-slugger) and stamps that same slug as the
// id= on the rendered <h2> in <Content />, so a plain #slug anchor link
// here is guaranteed to match without any extra id-generation of our own.
const tocHeadings = headings.filter((h) => h.depth === 2);

const formattedDate = pubDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

// "More like this" — suggestions based on the post being read, not just
// chronological adjacency: same category scores highest, shared tags add
// a smaller boost, ties broken by recency. Falls back to just "most
// recent other posts" naturally, since with no matches every score is 0
// and recency alone decides the order.
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const categoryScore = p.data.category === category ? 10 : 0;
    const tagScore = p.data.tags.filter((t) => tags.includes(t)).length * 3;
    return { post: p, score: categoryScore + tagScore };
  })
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map((s) => s.post);
---

<BaseLayout title={title} description={description}>
  <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-pen z-[70]" style="width:0%"></div>
  <div class="mx-auto max-w-5xl px-6 pt-10 sm:pt-14 pb-8">
    <article class="relative">
    <!-- No max-w-4xl narrowing here — the article fills this container's
         full width, same as the footer's panel below it, so the
         two visibly line up edge-to-edge, not just share a center point
         (an earlier version kept the article narrower for reading width,
         which per direct feedback read as "not aligned" against the
         footer even though both were centered on the same midpoint).
         TOC breaks out into the page margin via absolute positioning
         instead of widening this page's own container past max-w-5xl
         (which every other page, and the footer, are built to) — an
         earlier version used a wider max-w-6xl wrapper to make room
         for the TOC column, which left this page's content visibly
         wider than the nav/footer above and below it. top-0 + bottom-0
         with no explicit height stretches this <nav> to the article's
         full height (same reasoning as avoiding items-start on a
         grid), giving the sticky child room to travel. Only at 2xl:
         and up — that's the first breakpoint with enough real page
         margin outside max-w-5xl for a 200px column positioned this
         far out (232px total) without ever overlapping the prose. -->
    {tocHeadings.length > 1 && (
      <nav aria-label="Table of contents" class="hidden 2xl:block absolute top-0 bottom-0 -left-[232px] w-[200px]">
        <div class="sticky top-24">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-ink-soft mb-3">On this page</p>
          <ul id="toc-list" class="space-y-1 doc-rail">
            {tocHeadings.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  data-toc-link={h.slug}
                  class="toc-link block pl-3 -ml-px border-l-2 border-transparent text-xs text-ink-soft hover:text-ink transition-colors leading-snug py-1"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )}

    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.1em] text-ink-soft hover:text-pen transition-colors mb-6"
    >
      ← All entries
    </a>

    <div class="panel p-8 sm:p-12">
      <div class="flex items-center gap-3 mb-5">
        <StatusChip label={category} tone="pen" />
        <span class="font-mono text-xs text-ink-soft">
          {formattedDate} · {readingMinutes} min read
          {updatedDate && ` · updated ${updatedDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}`}
        </span>
      </div>

      <h1 class="font-display font-semibold text-3xl sm:text-[2.5rem] leading-[1.15] tracking-[-0.01em] text-ink text-balance">
        {title}
      </h1>
      <p class="mt-4 text-lg text-ink-soft leading-relaxed">{description}</p>

      {coverImage && (
        <img
          src={coverImage.src}
          alt={coverImageAlt ?? ""}
          class="mt-8 w-full rounded-md border border-line"
        />
      )}

      <div class="prose prose--dropcap mt-10 max-w-none">
        <Content />
      </div>

      {tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-line flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="font-mono text-[0.65rem] text-ink-soft border border-line rounded-[3px] px-2 py-0.5 bg-paper/50">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>

    {relatedPosts.length > 0 && (
      <div class="mt-6">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-ink-soft mb-3">More like this</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedPosts.map((p) => (
            <a
              href={`/blog/${p.id}`}
              class="group panel block p-5 hover:border-pen/50 transition-colors"
            >
              <StatusChip label={p.data.category} tone="pen" class="mb-2" />
              <p class="font-display font-medium text-base text-ink group-hover:text-pen transition-colors leading-snug">
                {p.data.title}
              </p>
              <p class="mt-1.5 text-xs text-ink-soft leading-relaxed line-clamp-2">{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    )}
    </article>
  </div>

  <script>
    // Reading-progress bar: whole-document scroll fraction, not a precise
    // article-bounds calculation — the article fills essentially the whole
    // page on this route, so this is an accurate enough approximation
    // without needing to track the article's own offset/height separately.
    // Re-queries the bar element fresh on every call rather than caching
    // it once — with View Transitions, navigating between two different
    // blog posts swaps in a *different* #reading-progress element (a new
    // post's DOM), and a cached reference from the previous post would go
    // stale. Fully stateless/idempotent on purpose: safe to call more
    // than once per actual scroll/page-load without any visible effect,
    // which matters because it isn't guaranteed this script's top level
    // only ever runs once across client-side navigations between two
    // pages sharing this same template.
    function updateProgress() {
      const bar = document.getElementById("reading-progress");
      if (!bar) return;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const pct = scrollable > 0 ? Math.min(100, Math.max(0, (window.scrollY / scrollable) * 100)) : 0;
      bar.style.width = pct + "%";
    }
    document.addEventListener("astro:page-load", updateProgress);
    window.addEventListener("scroll", updateProgress, { passive: true });
    window.addEventListener("resize", updateProgress);

    // Table of contents scroll-spy: highlights whichever section is
    // currently at the top of the viewport as the reader scrolls. Kept
    // in its own `let` + init function (astro:page-load pattern, same
    // reasoning as updateProgress above) rather than a plain top-level
    // IntersectionObserver, since a soft navigation between two posts
    // swaps in a completely different set of headings — a stale
    // observer from the previous post would otherwise keep watching
    // (and its callback firing against) DOM nodes that no longer exist
    // on the page.
    let tocObserver: IntersectionObserver | null = null;

    function initToc() {
      tocObserver?.disconnect();
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
      if (tocLinks.length === 0) return;

      const headingEls = [...tocLinks]
        .map((link) => document.getElementById(link.dataset.tocLink ?? ""))
        .filter((el): el is HTMLElement => el !== null);

      function setActive(slug: string | null) {
        tocLinks.forEach((link) => {
          const active = link.dataset.tocLink === slug;
          link.classList.toggle("border-pen", active);
          link.classList.toggle("text-pen", active);
          link.classList.toggle("text-ink-soft", !active);
        });
      }

      tocObserver = new IntersectionObserver(
        (entries) => {
          // Several headings can intersect at once with a tall
          // rootMargin, so pick whichever intersecting one is closest
          // to the top of the viewport — that's the section actually
          // being read, not just "any heading currently on screen."
          const visible = entries.filter((e) => e.isIntersecting);
          if (visible.length > 0) {
            const topMost = visible.reduce((a, b) =>
              a.boundingClientRect.top < b.boundingClientRect.top ? a : b,
            );
            setActive(topMost.target.id);
          }
        },
        // Top offset clears the sticky nav; the large negative bottom
        // margin shrinks the observation zone to roughly the top third
        // of the viewport, so a heading only counts as "active" once
        // it's scrolled near the top, not anywhere on screen.
        { rootMargin: "-96px 0px -70% 0px", threshold: 0 },
      );

      headingEls.forEach((el) => tocObserver?.observe(el));
    }

    document.addEventListener("astro:page-load", initToc);
  </script>
</BaseLayout>
