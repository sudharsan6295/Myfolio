---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stamp from "../../components/Stamp.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, coverImage, coverImageAlt } = post.data;
const { Content } = await render(post);

const formattedDate = pubDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

// Prev/next in the same newest-first order the /blog list uses, so "which
// one is next" matches what a reader saw there. Labeled by actual title
// and direction rather than ambiguous "prev/next" — index-1 is newer
// (listed above this one), index+1 is older (listed below it).
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : undefined;
const olderPost = currentIndex >= 0 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : undefined;
---

<BaseLayout title={title} description={description}>
  <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-pen z-[70]" style="width:0%"></div>
  <article class="mx-auto max-w-3xl px-6 pt-10 sm:pt-14 pb-8">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.1em] text-ink-soft hover:text-pen transition-colors mb-6"
    >
      ← All entries
    </a>

    <div class="glass rounded-3xl p-8 sm:p-12">
      <div class="flex items-center gap-3 mb-5">
        <Stamp label={category} tone="pen" />
        <span class="font-mono text-xs text-ink-soft">
          {formattedDate} · {readingMinutes} min read
          {updatedDate && ` · updated ${updatedDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}`}
        </span>
      </div>

      <h1 class="font-display font-normal text-3xl sm:text-[2.5rem] leading-[1.15] tracking-[-0.01em] text-ink text-balance">
        {title}
      </h1>
      <p class="mt-4 text-lg text-ink-soft leading-relaxed">{description}</p>

      {coverImage && (
        <img
          src={coverImage.src}
          alt={coverImageAlt ?? ""}
          class="mt-8 w-full rounded-2xl border border-line"
        />
      )}

      <div class="prose prose--dropcap mt-10 max-w-none">
        <Content />
      </div>

      {tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-line flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="font-mono text-[0.65rem] text-ink-soft border border-line rounded-[3px] px-2 py-0.5 bg-paper/50">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>

    {(newerPost || olderPost) && (
      <nav aria-label="More entries" class="mt-6 grid sm:grid-cols-2 gap-4">
        {olderPost ? (
          <a href={`/blog/${olderPost.id}`} class="group glass block rounded-2xl p-5 hover:bg-paper/75 transition-colors">
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.1em] text-ink-soft mb-1.5">← Older entry</p>
            <p class="font-display text-base text-ink group-hover:text-pen transition-colors leading-snug">{olderPost.data.title}</p>
          </a>
        ) : <div />}
        {newerPost ? (
          <a href={`/blog/${newerPost.id}`} class="group glass block rounded-2xl p-5 hover:bg-paper/75 transition-colors sm:text-right">
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.1em] text-ink-soft mb-1.5">Newer entry →</p>
            <p class="font-display text-base text-ink group-hover:text-pen transition-colors leading-snug">{newerPost.data.title}</p>
          </a>
        ) : <div />}
      </nav>
    )}
  </article>

  <script>
    // Reading-progress bar: whole-document scroll fraction, not a precise
    // article-bounds calculation — the article fills essentially the whole
    // page on this route, so this is an accurate enough approximation
    // without needing to track the article's own offset/height separately.
    const bar = document.getElementById("reading-progress");
    function updateProgress() {
      if (!bar) return;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const pct = scrollable > 0 ? Math.min(100, Math.max(0, (window.scrollY / scrollable) * 100)) : 0;
      bar.style.width = pct + "%";
    }
    updateProgress();
    window.addEventListener("scroll", updateProgress, { passive: true });
    window.addEventListener("resize", updateProgress);
  </script>
</BaseLayout>
