---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stamp from "../../components/Stamp.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, coverImage, coverImageAlt } = post.data;
const { Content } = await render(post);

const formattedDate = pubDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

// "More like this" — suggestions based on the post being read, not just
// chronological adjacency: same category scores highest, shared tags add
// a smaller boost, ties broken by recency. Falls back to just "most
// recent other posts" naturally, since with no matches every score is 0
// and recency alone decides the order.
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const categoryScore = p.data.category === category ? 10 : 0;
    const tagScore = p.data.tags.filter((t) => tags.includes(t)).length * 3;
    return { post: p, score: categoryScore + tagScore };
  })
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map((s) => s.post);
---

<BaseLayout title={title} description={description}>
  <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-pen z-[70]" style="width:0%"></div>
  <article class="mx-auto max-w-3xl px-6 pt-10 sm:pt-14 pb-8">
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.1em] text-ink-soft hover:text-pen transition-colors mb-6"
    >
      ← All entries
    </a>

    <div class="glass rounded-3xl p-8 sm:p-12">
      <div class="flex items-center gap-3 mb-5">
        <Stamp label={category} tone="pen" />
        <span class="font-mono text-xs text-ink-soft">
          {formattedDate} · {readingMinutes} min read
          {updatedDate && ` · updated ${updatedDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}`}
        </span>
      </div>

      <h1 class="font-display font-normal text-3xl sm:text-[2.5rem] leading-[1.15] tracking-[-0.01em] text-ink text-balance">
        {title}
      </h1>
      <p class="mt-4 text-lg text-ink-soft leading-relaxed">{description}</p>

      {coverImage && (
        <img
          src={coverImage.src}
          alt={coverImageAlt ?? ""}
          class="mt-8 w-full rounded-2xl border border-line"
        />
      )}

      <div class="prose prose--dropcap mt-10 max-w-none">
        <Content />
      </div>

      {tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-line flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="font-mono text-[0.65rem] text-ink-soft border border-line rounded-[3px] px-2 py-0.5 bg-paper/50">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>

    {relatedPosts.length > 0 && (
      <div class="mt-6">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-ink-soft mb-3">More like this</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedPosts.map((p) => (
            <a
              href={`/blog/${p.id}`}
              class="group glass block rounded-2xl p-5 hover:bg-paper/75 transition-colors"
            >
              <Stamp label={p.data.category} tone="pen" class="mb-2" />
              <p class="font-display text-base text-ink group-hover:text-pen transition-colors leading-snug">
                {p.data.title}
              </p>
              <p class="mt-1.5 text-xs text-ink-soft leading-relaxed line-clamp-2">{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </article>

  <script>
    // Reading-progress bar: whole-document scroll fraction, not a precise
    // article-bounds calculation — the article fills essentially the whole
    // page on this route, so this is an accurate enough approximation
    // without needing to track the article's own offset/height separately.
    const bar = document.getElementById("reading-progress");
    function updateProgress() {
      if (!bar) return;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const pct = scrollable > 0 ? Math.min(100, Math.max(0, (window.scrollY / scrollable) * 100)) : 0;
      bar.style.width = pct + "%";
    }
    updateProgress();
    window.addEventListener("scroll", updateProgress, { passive: true });
    window.addEventListener("resize", updateProgress);
  </script>
</BaseLayout>
