---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [aboutEntry] = await getCollection("about");
const about = aboutEntry?.data;

const categories = ["AI", "Business", "AI Product Management"] as const;
const categoryCounts = categories.map((c) => ({
  label: c,
  count: allPosts.filter((p) => p.data.category === c).length,
}));
---

<BaseLayout
  title="Blogs"
  description="Field notes on AI, business, and product management — written from the inside of shipping AI products, not from the outside looking in."
>
  <div class="mx-auto max-w-5xl px-6 pt-14 sm:pt-20 pb-24">
    <div class="glass rounded-3xl p-8 sm:p-10 mb-8">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-pen mb-4">Blogs</p>
      <h1 class="font-display font-normal text-4xl sm:text-[3.25rem] leading-[1.1] tracking-[-0.01em] text-ink text-balance">
        Field Notes
      </h1>
      <p class="mt-4 text-ink-soft leading-relaxed max-w-xl">
        Writing on AI, business, and product management — mostly the parts that
        don't survive the trip into a company blog post.
      </p>

      <!-- Category filter — client-side only, no navigation, keeps this a plain static page. -->
      <div id="category-filter" class="mt-8 flex flex-wrap gap-2">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="filter-btn inline-flex items-center font-mono text-[0.65rem] uppercase tracking-[0.14em] border rounded-[3px] px-2 py-1 -rotate-2 transition-colors border-pen/50 text-pen"
        >
          All ({allPosts.length})
        </button>
        {categoryCounts.map(({ label, count }) => (
          <button
            type="button"
            data-filter={label}
            aria-pressed="false"
            class="filter-btn inline-flex items-center font-mono text-[0.65rem] uppercase tracking-[0.14em] border rounded-[3px] px-2 py-1 -rotate-2 transition-colors border-ink/40 text-ink opacity-60 hover:opacity-100"
          >
            {label} ({count})
          </button>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-6 lg:gap-8 items-start">
      <div>
        <div id="post-list">
          {allPosts.length === 0 ? (
            <p class="text-ink-soft text-sm py-10">
              No entries yet — add a Markdown file to <code class="font-mono text-xs bg-paper-raised px-1.5 py-0.5 rounded">src/content/blog/</code> and redeploy.
            </p>
          ) : (
            allPosts.map((post, i) => (
              <div data-category={post.data.category}>
                <PostCard post={post} entryNumber={allPosts.length - i} />
              </div>
            ))
          )}
        </div>
        <p id="empty-state" class="hidden text-ink-soft text-sm py-10">
          Nothing filed under this category yet.
        </p>
      </div>

      <aside aria-label="About the author" class="glass rounded-3xl p-6 sticky top-24">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft mb-3 border-b border-line pb-2">
          Written by
        </p>
        <p class="font-display text-lg text-ink">{about?.name ?? "Sudharsan Balaji"}</p>
        <p class="text-sm text-ink-soft mt-1">{about?.role}</p>
        <p class="text-sm text-ink-soft leading-relaxed mt-3">{about?.tagline}</p>
        <a
          href="/about"
          class="mt-4 inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-pen hover:text-ink transition-colors"
        >
          More about me →
        </a>
      </aside>
    </div>
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const items = document.querySelectorAll<HTMLElement>("#post-list > [data-category]");
    const emptyState = document.getElementById("empty-state");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter;
        let visibleCount = 0;

        buttons.forEach((b) => {
          const active = b === btn;
          b.setAttribute("aria-pressed", String(active));
          b.classList.toggle("border-pen/50", active);
          b.classList.toggle("text-pen", active);
          b.classList.toggle("opacity-100", active);
          b.classList.toggle("border-ink/40", !active);
          b.classList.toggle("text-ink", !active);
          b.classList.toggle("opacity-60", !active);
        });

        items.forEach((item) => {
          const show = filter === "all" || item.dataset.category === filter;
          item.style.display = show ? "" : "none";
          if (show) visibleCount++;
        });

        emptyState?.classList.toggle("hidden", visibleCount !== 0);
      });
    });
  </script>
</BaseLayout>
