---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Reading time per post, for the "Quick reads first" sort option — same
// formula PostCard.astro uses, computed here too since the sort has to
// run client-side against a data-attribute (this is a static site, no
// server to sort on).
function readingMinutesFor(body: string | undefined) {
  const wordCount = (body ?? "").trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(wordCount / 200));
}

const [aboutEntry] = await getCollection("about");
const about = aboutEntry?.data;

// Categories are open-ended (see content.config.ts) — derived from
// whatever's actually used across the posts, not a fixed list, so
// adding/renaming/retiring a category is just a matter of what's in a
// post's frontmatter. Most-used first (a lone post in a new category
// shouldn't crowd out the categories people actually read), ties
// broken alphabetically for a stable, predictable order.
const categoryCounts = [...new Set(allPosts.map((p) => p.data.category))]
  .map((label) => ({ label, count: allPosts.filter((p) => p.data.category === label).length }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
---

<BaseLayout
  title="Notes"
  description="Field notes on AI, business, and product management."
>
  <div class="mx-auto max-w-5xl px-6 pt-10 sm:pt-14 pb-8">
    <div class="panel p-8 sm:p-10 mb-6">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-pen mb-4">Notes</p>
      <h1 class="font-display font-semibold text-4xl sm:text-[3.25rem] leading-[1.1] tracking-[-0.01em] text-ink text-balance">
        Field Notes
      </h1>
      <p class="mt-4 text-ink-soft leading-relaxed max-w-xl">
        I write about AI, business, and product management — the stuff I
        actually work with day to day. Short, useful reads on things I think
        matter.
      </p>

      <a
        href="/rss.xml"
        class="mt-3 inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-soft hover:text-pen transition-colors"
      >
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
          <path d="M2 2C8.6 2 14 7.4 14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <path d="M2 6.5C6.14 6.5 9.5 9.86 9.5 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <circle cx="3" cy="13" r="1.6" fill="currentColor" />
        </svg>
        Subscribe via RSS
      </a>

      <!-- Category filter — client-side only, no navigation, keeps this a plain static page. -->
      <div id="category-filter" class="mt-8 flex flex-wrap gap-2">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="filter-btn inline-flex items-center font-mono text-[0.65rem] uppercase tracking-[0.14em] border rounded-[3px] px-2 py-1 transition-colors border-pen/50 text-pen"
        >
          All ({allPosts.length})
        </button>
        {categoryCounts.map(({ label, count }) => (
          <button
            type="button"
            data-filter={label}
            aria-pressed="false"
            class="filter-btn inline-flex items-center font-mono text-[0.65rem] uppercase tracking-[0.14em] border rounded-[3px] px-2 py-1 transition-colors border-ink/40 text-ink opacity-60 hover:opacity-100"
          >
            {label} ({count})
          </button>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-6 lg:gap-8 items-start">
      <div>
        <!-- Narrower now, matching just this left column (the actual
             post list) rather than the full hero-panel width — per
             direct request, reverting the earlier full-width version. -->
        {allPosts.length > 1 && (
          <div class="panel p-3 flex flex-wrap items-center justify-between gap-2 mb-6">
            <div class="relative flex-1 min-w-[160px] max-w-xs ml-2">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" class="absolute left-2.5 top-1/2 -translate-y-1/2 text-ink-soft pointer-events-none">
                <circle cx="7" cy="7" r="5.2" stroke="currentColor" stroke-width="1.3" />
                <path d="M11 11L14.5 14.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
              </svg>
              <input
                type="search"
                id="post-search"
                placeholder="Search entries…"
                aria-label="Search entries"
                class="w-full h-8 font-mono text-[0.7rem] text-ink placeholder:text-ink-soft/70 bg-paper/60 border border-line rounded-[3px] pl-8 pr-3 focus:outline-none focus:border-pen"
              />
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <label for="sort-select" class="font-mono text-[0.65rem] uppercase tracking-[0.1em] text-ink-soft">
                Sort
              </label>
              <select
                id="sort-select"
                class="h-8 font-mono text-[0.65rem] uppercase tracking-[0.08em] text-ink bg-paper/60 border border-line rounded-[3px] px-2 focus:outline-none focus:border-pen"
              >
                <option value="newest">Newest first</option>
                <option value="oldest">Oldest first</option>
                <option value="title">Title A–Z</option>
                <option value="quick">Quick reads first</option>
              </select>
            </div>
          </div>
        )}

        <div id="post-list">
          {allPosts.length === 0 ? (
            <p class="text-ink-soft text-sm py-10">
              No entries yet — add a Markdown file to <code class="font-mono text-xs bg-paper-raised px-1.5 py-0.5 rounded">src/content/blog/</code> and redeploy.
            </p>
          ) : (
            allPosts.map((post, i) => (
              <div
                data-category={post.data.category}
                data-date={post.data.pubDate.valueOf()}
                data-title={post.data.title.toLowerCase()}
                data-minutes={readingMinutesFor(post.body)}
                data-search={[post.data.title, post.data.description, ...post.data.tags]
                  .join(" ")
                  .toLowerCase()}
              >
                <PostCard post={post} entryNumber={allPosts.length - i} />
              </div>
            ))
          )}
        </div>
        <p id="empty-state" class="hidden text-ink-soft text-sm py-10">
          Nothing matches here — try a different search or filter.
        </p>
      </div>

      <div class="flex flex-col gap-6 lg:sticky lg:top-24 self-start">
        <aside aria-label="About the author" class="panel p-6">
          <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft mb-3 border-b border-line pb-2">
            Written by
          </p>
          <p class="font-display font-medium text-lg text-ink">{about?.name ?? "Sudharsan Balaji"}</p>
          <p class="text-sm text-ink-soft leading-relaxed mt-2">{about?.tagline}</p>
          <a
            href="/about"
            class="mt-4 inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-pen hover:text-ink transition-colors"
          >
            More about me →
          </a>
        </aside>

        <aside aria-label="Subscribe" class="panel p-6">
          <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft mb-3 border-b border-line pb-2">
            Get new posts by email
          </p>
          <p class="text-sm text-ink-soft leading-relaxed mb-4">
            Pick the topics you care about — leave all unchecked for everything.
          </p>
          <form
            name="blog-subscribe"
            method="POST"
            id="subscribe-form"
            class="flex flex-col gap-3"
          >
            <p class="hidden">
              <label>Don't fill this out: <input name="bot-field" /></label>
            </p>
            <input
              type="email"
              name="email"
              required
              placeholder="you@email.com"
              class="w-full font-mono text-xs text-ink placeholder:text-ink-soft/70 bg-paper/60 border border-line rounded-[3px] px-3 py-2 focus:outline-none focus:border-pen"
            />
            <div class="flex flex-wrap gap-1.5">
              {categoryCounts.map(({ label }) => (
                <label class="category-check-label cursor-pointer">
                  <input type="checkbox" name="categories" value={label} class="sr-only" />
                  <span class="inline-flex items-center font-mono text-[0.6rem] uppercase tracking-[0.08em] border rounded-[3px] px-2 py-1 border-line text-ink-soft transition-colors">
                    {label}
                  </span>
                </label>
              ))}
            </div>
            <button
              type="submit"
              class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-paper bg-ink hover:bg-pen transition-colors rounded-[3px] px-3 py-2"
            >
              Subscribe
            </button>
          </form>
          <p id="subscribe-success" class="hidden text-sm text-pen mt-3">Subscribed — thanks!</p>
          <p id="subscribe-error" class="hidden text-sm text-ink-soft mt-3">
            Something went wrong — try again, or email me directly.
          </p>
        </aside>
      </div>
    </div>
  </div>

  <script>
    // Everything below is scoped to elements on this one page (no
    // document/window-level listeners here), so it's all wrapped in one
    // astro:page-load handler — with View Transitions, this page's own
    // DOM (and this script) isn't guaranteed to only ever run once per
    // session; astro:page-load fires on the real first load and again
    // after every client-side navigation back to this page, which is
    // what actually needs to happen here (a fresh #post-list, a reset
    // #sort-select, etc. each time this page is (re)entered).
    function initBlogPage() {
    // Subscribe form's category checkboxes: toggle the visible chip style
    // via JS classList rather than a CSS peer-checked selector — the
    // peer-checked variant matched (confirmed via .matches()) but didn't
    // actually win the cascade in this deeply-nested context, so this is
    // the reliable version, same approach as the filter buttons below.
    document.querySelectorAll<HTMLElement>(".category-check-label").forEach((label) => {
      const box = label.querySelector<HTMLInputElement>('input[type="checkbox"]');
      const chip = label.querySelector<HTMLElement>("span");
      if (!box || !chip) return;
      const sync = () => {
        chip.classList.toggle("border-pen", box.checked);
        chip.classList.toggle("text-pen", box.checked);
        chip.classList.toggle("bg-paper/60", box.checked);
        chip.classList.toggle("border-line", !box.checked);
        chip.classList.toggle("text-ink-soft", !box.checked);
      };
      box.addEventListener("change", sync);
      sync();
    });

    // Sort: reorders the actual DOM nodes (appendChild on an already-
    // attached node moves it, doesn't clone it) rather than hide/show like
    // the category filter does — sorting changes order, filtering changes
    // visibility, and both can be active at once independently.
    const sortSelect = document.getElementById("sort-select") as HTMLSelectElement | null;
    const postList = document.getElementById("post-list");

    sortSelect?.addEventListener("change", () => {
      if (!postList) return;
      const nodes = [...postList.children] as HTMLElement[];
      nodes.sort((a, b) => {
        switch (sortSelect.value) {
          case "oldest":
            return Number(a.dataset.date) - Number(b.dataset.date);
          case "title":
            return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "");
          case "quick":
            return Number(a.dataset.minutes) - Number(b.dataset.minutes);
          case "newest":
          default:
            return Number(b.dataset.date) - Number(a.dataset.date);
        }
      });
      nodes.forEach((node) => postList.appendChild(node));
    });

    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const items = document.querySelectorAll<HTMLElement>("#post-list > [data-category]");
    const emptyState = document.getElementById("empty-state");
    const searchInput = document.getElementById("post-search") as HTMLInputElement | null;

    // Category filter and search both narrow the same list independently —
    // combined here into one shared visibility pass (a card must pass BOTH
    // the active category and the current search text) rather than two
    // separate handlers that could each clobber the other's hide/show state.
    let activeCategory = "all";

    function applyVisibility() {
      const query = (searchInput?.value ?? "").trim().toLowerCase();
      let visibleCount = 0;
      items.forEach((item) => {
        const matchesCategory = activeCategory === "all" || item.dataset.category === activeCategory;
        const matchesSearch = query === "" || (item.dataset.search ?? "").includes(query);
        const show = matchesCategory && matchesSearch;
        item.style.display = show ? "" : "none";
        if (show) visibleCount++;
      });
      emptyState?.classList.toggle("hidden", visibleCount !== 0);
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCategory = btn.dataset.filter ?? "all";

        buttons.forEach((b) => {
          const active = b === btn;
          b.setAttribute("aria-pressed", String(active));
          b.classList.toggle("border-pen/50", active);
          b.classList.toggle("text-pen", active);
          b.classList.toggle("opacity-100", active);
          b.classList.toggle("border-ink/40", !active);
          b.classList.toggle("text-ink", !active);
          b.classList.toggle("opacity-60", !active);
        });

        applyVisibility();
      });
    });

    searchInput?.addEventListener("input", applyVisibility);

    // Posts to a Vercel Function (api/subscribe.ts), which stores the
    // subscriber in Vercel Blob — a separate cron-scheduled function
    // (api/notify-subscribers.ts) reads that store and actually emails
    // people when a new post goes up. Only works once deployed to Vercel
    // and run via `vercel dev` locally; a plain `astro dev` server has no
    // Vercel Functions runtime, so this fetch will fail there (the error
    // message below will show, which is correct — there genuinely is
    // nothing listening locally without `vercel dev`).
    const subscribeForm = document.getElementById("subscribe-form") as HTMLFormElement | null;
    const subscribeSuccess = document.getElementById("subscribe-success");
    const subscribeError = document.getElementById("subscribe-error");

    subscribeForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      subscribeError?.classList.add("hidden");
      // Build params by hand (not `new URLSearchParams(new FormData(...))`) —
      // that constructor collapses repeated keys, which the "categories"
      // checkboxes rely on (one entry per checked box, same name).
      const params = new URLSearchParams();
      for (const [key, value] of new FormData(subscribeForm).entries()) {
        params.append(key, value as string);
      }
      try {
        const response = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: params.toString(),
        });
        if (!response.ok) throw new Error(`${response.status}`);
        subscribeForm.reset();
        subscribeForm.classList.add("hidden");
        subscribeSuccess?.classList.remove("hidden");
      } catch {
        subscribeError?.classList.remove("hidden");
      }
    });
    }

    document.addEventListener("astro:page-load", initBlogPage);
  </script>
</BaseLayout>
