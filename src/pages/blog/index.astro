---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [aboutEntry] = await getCollection("about");
const about = aboutEntry?.data;

const categories = [
  "AI",
  "Business",
  "AI Product Management",
  "Personal Finance",
  "Aquariums & Fishkeeping",
] as const;
const categoryCounts = categories.map((c) => ({
  label: c,
  count: allPosts.filter((p) => p.data.category === c).length,
}));
---

<BaseLayout
  title="Blogs"
  description="Field notes on AI, business, product management, personal finance, and life with a home aquarium."
>
  <div class="mx-auto max-w-5xl px-6 pt-10 sm:pt-14 pb-8">
    <div class="glass rounded-3xl p-8 sm:p-10 mb-6">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-pen mb-4">Blogs</p>
      <h1 class="font-display font-normal text-4xl sm:text-[3.25rem] leading-[1.1] tracking-[-0.01em] text-ink text-balance">
        Field Notes
      </h1>
      <p class="mt-4 text-ink-soft leading-relaxed max-w-xl">
        Writing on AI, business, and product management — plus personal
        finance and life with a home aquarium — mostly the parts that don't
        survive the trip into a company blog post.
      </p>

      <!-- Category filter — client-side only, no navigation, keeps this a plain static page. -->
      <div id="category-filter" class="mt-8 flex flex-wrap gap-2">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="filter-btn inline-flex items-center font-mono text-[0.65rem] uppercase tracking-[0.14em] border rounded-[3px] px-2 py-1 -rotate-2 hover:rotate-0 transition-all duration-200 border-pen/50 text-pen"
        >
          All ({allPosts.length})
        </button>
        {categoryCounts.map(({ label, count }) => (
          <button
            type="button"
            data-filter={label}
            aria-pressed="false"
            class="filter-btn inline-flex items-center font-mono text-[0.65rem] uppercase tracking-[0.14em] border rounded-[3px] px-2 py-1 -rotate-2 hover:rotate-0 transition-all duration-200 border-ink/40 text-ink opacity-60 hover:opacity-100"
          >
            {label} ({count})
          </button>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-6 lg:gap-8 items-start">
      <div>
        <div id="post-list">
          {allPosts.length === 0 ? (
            <p class="text-ink-soft text-sm py-10">
              No entries yet — add a Markdown file to <code class="font-mono text-xs bg-paper-raised px-1.5 py-0.5 rounded">src/content/blog/</code> and redeploy.
            </p>
          ) : (
            allPosts.map((post, i) => (
              <div data-category={post.data.category}>
                <PostCard post={post} entryNumber={allPosts.length - i} />
              </div>
            ))
          )}
        </div>
        <p id="empty-state" class="hidden text-ink-soft text-sm py-10">
          Nothing filed under this category yet.
        </p>
      </div>

      <div class="flex flex-col gap-6 lg:sticky lg:top-24 self-start">
        <aside aria-label="About the author" class="glass rounded-3xl p-6">
          <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft mb-3 border-b border-dashed border-line pb-2">
            Written by
          </p>
          <p class="font-display text-lg text-ink">{about?.name ?? "Sudharsan Balaji"}</p>
          <p class="text-sm text-ink-soft mt-1">{about?.role}</p>
          <p class="text-sm text-ink-soft leading-relaxed mt-3">{about?.tagline}</p>
          <a
            href="/about"
            class="mt-4 inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-pen hover:text-ink transition-colors"
          >
            More about me →
          </a>
        </aside>

        <aside aria-label="Subscribe" class="glass rounded-3xl p-6">
          <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft mb-3 border-b border-dashed border-line pb-2">
            Get new posts by email
          </p>
          <p class="text-sm text-ink-soft leading-relaxed mb-4">
            Pick the topics you care about — leave all unchecked for everything.
          </p>
          <form
            name="blog-subscribe"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            id="subscribe-form"
            class="flex flex-col gap-3"
          >
            <input type="hidden" name="form-name" value="blog-subscribe" />
            <p class="hidden">
              <label>Don't fill this out: <input name="bot-field" /></label>
            </p>
            <input
              type="email"
              name="email"
              required
              placeholder="you@email.com"
              class="w-full font-mono text-xs text-ink placeholder:text-ink-soft/70 bg-paper/60 border border-line rounded-[3px] px-3 py-2 focus:outline-none focus:border-pen"
            />
            <div class="flex flex-wrap gap-1.5">
              {categories.map((c) => (
                <label class="category-check-label cursor-pointer">
                  <input type="checkbox" name="categories" value={c} class="sr-only" />
                  <span class="inline-flex items-center font-mono text-[0.6rem] uppercase tracking-[0.08em] border rounded-[3px] px-2 py-1 border-line text-ink-soft transition-colors">
                    {c}
                  </span>
                </label>
              ))}
            </div>
            <button
              type="submit"
              class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-paper bg-ink hover:bg-pen active:scale-[0.97] transition-all duration-150 rounded-[3px] px-3 py-2"
            >
              Subscribe
            </button>
          </form>
          <p id="subscribe-success" class="hidden text-sm text-pen mt-3">Subscribed — thanks!</p>
          <p id="subscribe-error" class="hidden text-sm text-ink-soft mt-3">
            Something went wrong — try again, or email me directly.
          </p>
        </aside>
      </div>
    </div>
  </div>

  <script>
    // Subscribe form's category checkboxes: toggle the visible chip style
    // via JS classList rather than a CSS peer-checked selector — the
    // peer-checked variant matched (confirmed via .matches()) but didn't
    // actually win the cascade in this deeply-nested context, so this is
    // the reliable version, same approach as the filter buttons below.
    document.querySelectorAll<HTMLElement>(".category-check-label").forEach((label) => {
      const box = label.querySelector<HTMLInputElement>('input[type="checkbox"]');
      const chip = label.querySelector<HTMLElement>("span");
      if (!box || !chip) return;
      const sync = () => {
        chip.classList.toggle("border-pen", box.checked);
        chip.classList.toggle("text-pen", box.checked);
        chip.classList.toggle("bg-paper/60", box.checked);
        chip.classList.toggle("border-line", !box.checked);
        chip.classList.toggle("text-ink-soft", !box.checked);
      };
      box.addEventListener("change", sync);
      sync();
    });

    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const items = document.querySelectorAll<HTMLElement>("#post-list > [data-category]");
    const emptyState = document.getElementById("empty-state");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter;
        let visibleCount = 0;

        buttons.forEach((b) => {
          const active = b === btn;
          b.setAttribute("aria-pressed", String(active));
          b.classList.toggle("border-pen/50", active);
          b.classList.toggle("text-pen", active);
          b.classList.toggle("opacity-100", active);
          b.classList.toggle("border-ink/40", !active);
          b.classList.toggle("text-ink", !active);
          b.classList.toggle("opacity-60", !active);
        });

        items.forEach((item) => {
          const show = filter === "all" || item.dataset.category === filter;
          item.style.display = show ? "" : "none";
          if (show) visibleCount++;
        });

        emptyState?.classList.toggle("hidden", visibleCount !== 0);
      });
    });

    // Netlify Forms: submit via fetch so the page doesn't reload. Only
    // actually captures anything once this site is deployed to Netlify —
    // locally (`astro dev`) the POST still resolves OK (so the success
    // message shows either way) but there's no real Netlify backend behind
    // it here, so nothing is actually saved until it's live.
    const subscribeForm = document.getElementById("subscribe-form") as HTMLFormElement | null;
    const subscribeSuccess = document.getElementById("subscribe-success");
    const subscribeError = document.getElementById("subscribe-error");

    subscribeForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      subscribeError?.classList.add("hidden");
      // Build params by hand (not `new URLSearchParams(new FormData(...))`) —
      // that constructor collapses repeated keys, which the "categories"
      // checkboxes rely on (one entry per checked box, same name).
      const params = new URLSearchParams();
      for (const [key, value] of new FormData(subscribeForm).entries()) {
        params.append(key, value as string);
      }
      try {
        const response = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: params.toString(),
        });
        if (!response.ok) throw new Error(`${response.status}`);
        subscribeForm.reset();
        subscribeForm.classList.add("hidden");
        subscribeSuccess?.classList.remove("hidden");
      } catch {
        subscribeError?.classList.remove("hidden");
      }
    });
  </script>
</BaseLayout>
