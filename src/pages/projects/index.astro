---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);

const [aboutEntry] = await getCollection("about");
const github = aboutEntry?.data.social.github;
---

<BaseLayout
  title="Workbench"
  description="MVPs and prototypes built outside the day job — some live, some archived, all documented for what they actually taught me."
>
  <div class="mx-auto max-w-5xl px-6 pt-10 sm:pt-14 pb-8">
    <div class="glass rounded-3xl p-8 sm:p-10 mb-6">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-pen mb-4">Projects &amp; Prototypes</p>
      <h1 class="font-display font-normal text-4xl sm:text-[3.25rem] leading-[1.1] tracking-[-0.01em] text-ink text-balance">
        The Workbench
      </h1>
      <p class="mt-4 text-ink-soft leading-relaxed max-w-xl">
        Side projects, MVPs, and prototypes — built to test an idea, not to hit a
        roadmap. Each one notes what shipped, what didn't, and why.
      </p>
      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-pen hover:text-ink transition-colors"
        >
          More on GitHub →
        </a>
      )}
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {projects.length === 0 ? (
        <p class="text-ink-soft text-sm py-10 col-span-full">
          No projects yet — add a Markdown file to <code class="font-mono text-xs bg-paper-raised px-1.5 py-0.5 rounded">src/content/projects/</code> and redeploy.
        </p>
      ) : (
        projects.map((project) => <ProjectCard project={project} />)
      )}
    </div>
  </div>
</BaseLayout>
