---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stamp from "../../components/Stamp.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, status, startDate, stack, links, coverImage, coverImageAlt } = project.data;
const { Content, headings } = await render(project);

// Table of contents — same pattern as blog/[id].astro's: H2 sections
// only (every write-up's actual structure), only shown when there's
// more than one. Astro slugs headings by default and stamps that same
// slug as id= on the rendered heading, so #slug anchors just work.
const tocHeadings = headings.filter((h) => h.depth === 2);

const statusTone: Record<string, "pen" | "highlight" | "ink"> = {
  live: "pen",
  prototype: "highlight",
  archived: "ink",
};

const linkLabels: Record<string, string> = {
  demo: "View live demo",
  repo: "View source",
  writeup: "Read the full write-up",
};
---

<BaseLayout title={title} description={summary}>
  <div class="mx-auto max-w-5xl px-6 pt-10 sm:pt-14 pb-8">
    <article class="relative">
    <!-- Same treatment as blog/[id].astro — see that file's comment for
         the full reasoning: no max-w-4xl narrowing, so this article's
         glass card lines up edge-to-edge with the footer's, not just a
         shared center point. TOC breaks out into the page margin via
         absolute positioning instead of widening this page's own
         container past max-w-5xl (an earlier version did that, and left
         this page's content visibly wider than the nav/footer above and
         below it). top-0 + bottom-0 with no explicit height stretches
         this <nav> to the article's full height, giving the sticky
         child room to travel. 2xl: and up only — the first breakpoint
         with enough real margin outside max-w-5xl for this. -->
    {tocHeadings.length > 1 && (
      <nav aria-label="Table of contents" class="hidden 2xl:block absolute top-0 bottom-0 -left-[232px] w-[200px]">
        <div class="sticky top-24">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-ink-soft mb-3">On this page</p>
          <ul id="toc-list" class="space-y-1 border-l border-line">
            {tocHeadings.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  data-toc-link={h.slug}
                  class="toc-link block pl-3 -ml-px border-l-2 border-transparent text-xs text-ink-soft hover:text-ink transition-colors leading-snug py-1"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )}

    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.1em] text-ink-soft hover:text-pen transition-colors mb-6"
    >
      ← Workbench
    </a>

    <div class="glass rounded-3xl p-8 sm:p-12">
      <div class="flex items-center gap-3 mb-5">
        <Stamp label={status} tone={statusTone[status] ?? "ink"} />
        <span class="font-mono text-xs text-ink-soft">
          Started {startDate.toLocaleDateString("en-US", { month: "long", year: "numeric" })}
        </span>
      </div>

      <h1 class="font-display font-normal text-3xl sm:text-[2.5rem] leading-[1.15] tracking-[-0.01em] text-ink text-balance">
        {title}
      </h1>
      <p class="mt-4 text-lg text-ink-soft leading-relaxed">{summary}</p>

      {stack.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-1.5">
          {stack.map((item) => (
            <span class="font-mono text-[0.65rem] text-ink-soft border border-line rounded-[3px] px-2 py-0.5 bg-paper/50">
              {item}
            </span>
          ))}
        </div>
      )}

      {coverImage && (
        <img
          src={coverImage.src}
          alt={coverImageAlt ?? ""}
          class="mt-8 w-full rounded-2xl border border-line"
        />
      )}

      <div class="prose mt-10 max-w-none">
        <Content />
      </div>

      {Object.entries(links).filter(([, url]) => url).length > 0 && (
        <div class="mt-12 pt-6 border-t border-line flex flex-wrap gap-4">
          {Object.entries(links).map(([key, url]) =>
            url ? (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.1em] text-pen hover:text-ink transition-colors"
              >
                {linkLabels[key] ?? key} ↗
              </a>
            ) : null,
          )}
        </div>
      )}
    </div>
    </article>
  </div>

  <script>
    // Table of contents scroll-spy — identical pattern to
    // blog/[id].astro's initToc (see that file for the full reasoning
    // in comments): astro:page-load re-init since a soft navigation
    // between two project pages swaps in a different heading set, and
    // the previous page's observer is explicitly disconnected first.
    let tocObserver: IntersectionObserver | null = null;

    function initToc() {
      tocObserver?.disconnect();
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
      if (tocLinks.length === 0) return;

      const headingEls = [...tocLinks]
        .map((link) => document.getElementById(link.dataset.tocLink ?? ""))
        .filter((el): el is HTMLElement => el !== null);

      function setActive(slug: string | null) {
        tocLinks.forEach((link) => {
          const active = link.dataset.tocLink === slug;
          link.classList.toggle("border-pen", active);
          link.classList.toggle("text-pen", active);
          link.classList.toggle("text-ink-soft", !active);
        });
      }

      tocObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting);
          if (visible.length > 0) {
            const topMost = visible.reduce((a, b) =>
              a.boundingClientRect.top < b.boundingClientRect.top ? a : b,
            );
            setActive(topMost.target.id);
          }
        },
        { rootMargin: "-96px 0px -70% 0px", threshold: 0 },
      );

      headingEls.forEach((el) => tocObserver?.observe(el));
    }

    document.addEventListener("astro:page-load", initToc);
  </script>
</BaseLayout>
