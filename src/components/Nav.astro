---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const { pathname } = Astro.url;

const [aboutEntry] = await getCollection("about");
const about = aboutEntry?.data;

const name = about?.name ?? "Sudharsan Balaji";
const initials = name
  .split(" ")
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0])
  .join("")
  .toUpperCase();

const links = [
  { href: "/about", label: "About Me" },
  { href: "/blog", label: "Blogs" },
  { href: "/projects", label: "Workbench" },
];

function isActive(href: string) {
  return pathname === href || pathname.startsWith(href + "/");
}

const linkedinHandle = about?.social?.linkedin
  ? "in/" +
    about.social.linkedin
      .replace(/^https?:\/\/(www\.)?linkedin\.com\/in\//i, "")
      .replace(/\/$/, "")
  : null;

const githubHandle = about?.social?.github
  ? "@" +
    about.social.github
      .replace(/^https?:\/\/(www\.)?github\.com\//i, "")
      .replace(/\/$/, "")
  : null;

const hasConnectLinks = about?.email || linkedinHandle || githubHandle;

// The Connect <details> below is rendered as a sibling of the <ul>, not
// inside it — an overflow-x-auto ancestor (the <ul>, a mobile-width safety
// net for the 3 page links) clips an absolutely-positioned popover, so
// Connect has to live outside that scroll container to render unclipped.
---

<header class="glass nav-glass sticky top-0 z-40">
  <div class="mx-auto max-w-5xl px-6">
    <nav class="flex items-center justify-between h-16" aria-label="Primary">
      <div class="flex items-center gap-2.5">
        {about?.photo ? (
          <button
            type="button"
            id="avatar-trigger"
            class="h-8 w-8 rounded-full overflow-hidden border border-line shrink-0 cursor-zoom-in"
            aria-label={`View ${name}'s photo`}
          >
            <Image
              src={about.photo}
              alt={about.photoAlt ?? `${name}'s profile photo`}
              width={64}
              height={64}
              class="h-full w-full object-cover"
            />
          </button>
        ) : (
          <a
            href="/"
            class="h-8 w-8 rounded-full bg-paper-raised border border-line flex items-center justify-center font-mono text-[0.6rem] text-ink-soft shrink-0"
            aria-label="Home"
          >
            {initials}
          </a>
        )}
        <a href="/" class="hidden sm:inline font-display italic text-base text-ink hover:text-pen transition-colors">
          {name}
        </a>
      </div>

      <div class="flex items-center gap-0.5 sm:gap-2 min-w-0">
        <ul class="flex items-center gap-0.5 sm:gap-2 font-mono text-[0.65rem] sm:text-[0.7rem] uppercase tracking-[0.08em] sm:tracking-[0.1em] overflow-x-auto flex-nowrap min-w-0">
          {
            links.map((link) => (
              <li class="shrink-0">
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class:list={[
                    "inline-block px-2 sm:px-3 py-2 rounded-[3px] transition-colors",
                    isActive(link.href)
                      ? "text-ink bg-paper-raised/70"
                      : "text-ink-soft hover:text-ink hover:bg-paper-raised/40",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <button
          type="button"
          id="theme-toggle"
          class="shrink-0 inline-flex items-center justify-center h-7 w-7 rounded-[3px] text-ink-soft hover:text-ink hover:bg-paper-raised/40 transition-colors"
          aria-label="Toggle dark mode"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="theme-icon-sun">
            <circle cx="8" cy="8" r="3.2" stroke="currentColor" stroke-width="1.3" />
            <path
              d="M8 1v1.6M8 13.4V15M15 8h-1.6M2.6 8H1M12.9 3.1l-1.13 1.13M4.23 11.77L3.1 12.9M12.9 12.9l-1.13-1.13M4.23 4.23L3.1 3.1"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
            />
          </svg>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="theme-icon-moon">
            <path d="M14 8.5A6.5 6.5 0 117.5 2a5.2 5.2 0 006.5 6.5z" />
          </svg>
        </button>

        {hasConnectLinks && (
          <div class="relative shrink-0">
            <details class="contact-dropdown group">
              <summary
                class="list-none [&::-webkit-details-marker]:hidden cursor-pointer inline-block px-2 sm:px-3 py-2 rounded-[3px] font-mono text-[0.65rem] sm:text-[0.7rem] uppercase tracking-[0.08em] sm:tracking-[0.1em] transition-colors text-ink-soft hover:text-ink hover:bg-paper-raised/40 group-open:text-ink group-open:bg-paper-raised/70"
              >
                Connect
              </summary>
              <div class="glass absolute right-0 mt-2 w-52 rounded-2xl p-4 flex flex-col gap-2.5 z-50">
                {about?.email && (
                  <a
                    href={`mailto:${about.email}`}
                    class="flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.08em] normal-case text-ink-soft hover:text-pen transition-colors"
                  >
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="shrink-0">
                      <rect x="1.5" y="3.5" width="13" height="9" rx="1.3" stroke="currentColor" stroke-width="1.2" />
                      <path d="M2 4.2L8 8.8L14 4.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Email
                  </a>
                )}
                {linkedinHandle && about?.social?.linkedin && (
                  <a
                    href={about.social.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.08em] normal-case text-ink-soft hover:text-pen transition-colors"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="shrink-0">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                    LinkedIn
                  </a>
                )}
                {githubHandle && about?.social?.github && (
                  <a
                    href={about.social.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.08em] normal-case text-ink-soft hover:text-pen transition-colors"
                  >
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="shrink-0">
                      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
                    </svg>
                    GitHub
                  </a>
                )}
              </div>
            </details>
          </div>
        )}
      </div>
    </nav>
  </div>
</header>

{about?.photo && (
  <div
    id="avatar-lightbox"
    class="hidden fixed inset-0 z-[100] items-center justify-center p-6"
    role="dialog"
    aria-modal="true"
    aria-label={`${name}'s photo`}
  >
    <div id="avatar-lightbox-backdrop" class="absolute inset-0 bg-ink/70 backdrop-blur-sm"></div>
    <button
      type="button"
      id="avatar-lightbox-close"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 h-9 w-9 rounded-full glass flex items-center justify-center text-ink hover:text-pen transition-colors z-10"
      aria-label="Close"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M2 2L14 14M14 2L2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
    <Image
      src={about.photo}
      alt={about.photoAlt ?? `${name}'s profile photo`}
      width={900}
      class="relative z-0 max-h-[85vh] max-w-[90vw] w-auto h-auto rounded-2xl border border-line shadow-2xl object-contain"
    />
  </div>
)}

<script>
  // Theme toggle: flips between explicit light/dark, persisted so it
  // survives a reload (applied pre-paint by the inline script in
  // BaseLayout.astro's <head>, to avoid a flash of the previous theme).
  const themeToggle = document.getElementById("theme-toggle");

  function currentTheme(): "light" | "dark" {
    const attr = document.documentElement.getAttribute("data-theme");
    if (attr === "light" || attr === "dark") return attr;
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  themeToggle?.addEventListener("click", () => {
    const next = currentTheme() === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch (e) {}
  });

  // Connect popover: close on outside-click or Escape — <details>/<summary>
  // has no built-in dismissal.
  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLDetailsElement>(".contact-dropdown[open]").forEach((el) => {
      if (!el.contains(e.target as Node)) el.removeAttribute("open");
    });
  });

  // Avatar lightbox: click the avatar to enlarge the photo, click the
  // backdrop/close button or press Escape to dismiss.
  const trigger = document.getElementById("avatar-trigger");
  const lightbox = document.getElementById("avatar-lightbox");
  const backdrop = document.getElementById("avatar-lightbox-backdrop");
  const closeBtn = document.getElementById("avatar-lightbox-close");

  function openLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
    closeBtn?.focus();
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
    trigger?.focus();
  }

  trigger?.addEventListener("click", openLightbox);
  backdrop?.addEventListener("click", closeLightbox);
  closeBtn?.addEventListener("click", closeLightbox);

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    document.querySelectorAll<HTMLDetailsElement>(".contact-dropdown[open]").forEach((el) => {
      el.removeAttribute("open");
    });
    if (lightbox && !lightbox.classList.contains("hidden")) closeLightbox();
  });
</script>
