---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const { pathname } = Astro.url;

const [aboutEntry] = await getCollection("about");
const about = aboutEntry?.data;

const name = about?.name ?? "Sudharsan Balaji";
const initials = name
  .split(" ")
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0])
  .join("")
  .toUpperCase();

const links = [
  { href: "/about", label: "About Me" },
  { href: "/blog", label: "Blogs" },
  { href: "/projects", label: "Workbench" },
];

function isActive(href: string) {
  return pathname === href || pathname.startsWith(href + "/");
}
---

<header class="glass nav-glass sticky top-0 z-40">
  <div class="mx-auto max-w-5xl px-6">
    <nav class="flex items-center justify-between h-16" aria-label="Primary">
      <a href="/" class="group flex items-center gap-2.5">
        {about?.photo ? (
          <Image
            src={about.photo}
            alt={about.photoAlt ?? `${name}'s profile photo`}
            width={64}
            height={64}
            class="h-8 w-8 rounded-full object-cover border border-line"
          />
        ) : (
          <span
            class="h-8 w-8 rounded-full bg-paper-raised border border-line flex items-center justify-center font-mono text-[0.6rem] text-ink-soft"
            aria-hidden="true"
          >
            {initials}
          </span>
        )}
        <span class="font-display italic text-base text-ink group-hover:text-pen transition-colors">
          {name}
        </span>
      </a>

      <ul class="flex items-center gap-1 sm:gap-2 font-mono text-[0.7rem] uppercase tracking-[0.1em]">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "inline-block px-3 py-2 rounded-[3px] transition-colors",
                  isActive(link.href)
                    ? "text-ink bg-paper-raised/70"
                    : "text-ink-soft hover:text-ink hover:bg-paper-raised/40",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
