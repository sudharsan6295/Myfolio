---
// A small ink-stamp label — the site's one recurring signature motif.
// Used for post categories, project status, and entry numbers. Keep it rare:
// one or two per card, never decorative filler.
interface Props {
  label: string;
  tone?: "ink" | "pen" | "highlight";
  class?: string;
}

const { label, tone = "ink", class: className = "" } = Astro.props;

const toneClasses: Record<string, string> = {
  ink: "border-ink/40 text-ink",
  pen: "border-pen/50 text-pen",
  highlight: "border-highlight text-ink bg-highlight/20",
};
---

<span
  class:list={[
    "inline-flex items-center font-mono text-[0.65rem] uppercase tracking-[0.14em]",
    "border rounded-[3px] px-2 py-0.5 -rotate-2 select-none",
    toneClasses[tone],
    className,
  ]}
>
  {label}
</span>
