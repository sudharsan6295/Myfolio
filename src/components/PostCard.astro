---
import type { CollectionEntry } from "astro:content";
import Stamp from "./Stamp.astro";

interface Props {
  post: CollectionEntry<"blog">;
  entryNumber?: number;
}

const { post, entryNumber } = Astro.props;
const { title, description, pubDate, category } = post.data;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});

const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
---

<a
  href={`/blog/${post.id}`}
  class="group glass block rounded-2xl p-6 sm:p-7 mb-4 last:mb-0 hover:bg-paper/75 hover:-translate-y-0.5 active:translate-y-0"
>
  <div class="flex items-center gap-3 mb-3">
    {entryNumber !== undefined && (
      <span class="font-mono text-[0.7rem] text-ink-soft/70">
        №{String(entryNumber).padStart(3, "0")}
      </span>
    )}
    <Stamp label={category} tone="pen" class="group-hover:rotate-0!" />
    <span class="font-mono text-[0.7rem] text-ink-soft">{formattedDate} · {readingMinutes} min read</span>
  </div>

  <h3 class="font-display font-normal text-2xl sm:text-[1.6rem] leading-snug tracking-[-0.005em] text-ink group-hover:text-pen transition-colors">
    {title}
  </h3>
  <p class="mt-2 text-ink-soft leading-relaxed max-w-2xl">{description}</p>

  <span class="mt-3 inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-pen opacity-0 group-hover:opacity-100 transition-opacity">
    Read entry
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="translate-x-0 group-hover:translate-x-0.5 transition-transform">
      <path d="M2 6H10M10 6L6.5 2.5M10 6L6.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</a>
