---
import type { CollectionEntry } from "astro:content";
import Stamp from "./Stamp.astro";
import Seal from "./Seal.astro";

interface Props {
  post: CollectionEntry<"blog">;
  entryNumber?: number;
  // Larger spotlight treatment — used once per /blog page for the entry
  // marked `featured: true` in its frontmatter (see blog/index.astro).
  featured?: boolean;
}

const { post, entryNumber, featured = false } = Astro.props;
const { title, description, pubDate, category } = post.data;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});

const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
---

<a
  href={`/blog/${post.id}`}
  class:list={[
    "group glass block rounded-2xl hover:bg-paper/75 transition-colors",
    featured ? "p-7 sm:p-9" : "p-6 sm:p-7 mb-4 last:mb-0",
  ]}
>
  <div class="flex items-center gap-3 mb-3">
    {featured && <Seal size={30} tone="pen" />}
    {featured && <span class="sr-only">Featured</span>}
    {entryNumber !== undefined && !featured && (
      <span class="font-mono text-[0.7rem] text-ink-soft/70">
        №{String(entryNumber).padStart(3, "0")}
      </span>
    )}
    <Stamp label={category} tone="pen" />
    <span class="font-mono text-[0.7rem] text-ink-soft">{formattedDate} · {readingMinutes} min read</span>
  </div>

  <h3
    class:list={[
      "font-display font-normal leading-snug tracking-[-0.005em] text-ink group-hover:text-pen transition-colors",
      featured ? "text-3xl sm:text-4xl" : "text-2xl sm:text-[1.6rem]",
    ]}
  >
    {title}
  </h3>
  <p class:list={["mt-2 text-ink-soft leading-relaxed max-w-2xl", featured && "text-base sm:text-lg"]}>
    {description}
  </p>

  <span class="mt-3 inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-[0.1em] text-pen opacity-0 group-hover:opacity-100 transition-opacity">
    Read entry
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="translate-x-0 group-hover:translate-x-0.5 transition-transform">
      <path d="M2 6H10M10 6L6.5 2.5M10 6L6.5 9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</a>
