---
// A small engraved "wax seal" monogram. The site's original chosen concept
// was "Letterpress & Seal," but only the letterpress half (the rectangular
// <Stamp>) ever got built — this finishes it. Purely a visual flourish, so
// it's aria-hidden by default; pair it with its own visible or sr-only
// label at the call site when it needs to convey meaning (e.g. "Featured"),
// rather than overloading this component's accessible name. Kept to two
// places on purpose — the About page's intro panel (the site's signature)
// and marking the single featured entry on Blogs/Workbench — same "keep it
// rare" rule Stamp.astro already documents for itself.
interface Props {
  size?: number;
  tone?: "pen" | "ink";
  class?: string;
}

const { size = 34, tone = "pen", class: className = "" } = Astro.props;
const strokeColor = tone === "pen" ? "var(--color-pen)" : "var(--color-ink)";
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
  class:list={["-rotate-6 select-none shrink-0", className]}
  style={`color:${strokeColor}`}
>
  <circle cx="20" cy="20" r="18.5" stroke="currentColor" stroke-width="1" opacity="0.85" />
  <circle cx="20" cy="20" r="15" stroke="currentColor" stroke-width="0.6" opacity="0.45" />
  <!-- four ornamental ticks at the cardinal points, like a wax seal's edge -->
  <line x1="36.2" y1="20" x2="37.8" y2="20" stroke="currentColor" stroke-width="1" opacity="0.7" />
  <line x1="20" y1="36.2" x2="20" y2="37.8" stroke="currentColor" stroke-width="1" opacity="0.7" />
  <line x1="3.8" y1="20" x2="2.2" y2="20" stroke="currentColor" stroke-width="1" opacity="0.7" />
  <line x1="20" y1="3.8" x2="20" y2="2.2" stroke="currentColor" stroke-width="1" opacity="0.7" />
  <text
    x="20"
    y="25.5"
    text-anchor="middle"
    font-family="var(--font-display)"
    font-style="italic"
    font-weight="500"
    font-size="13"
    fill="currentColor"
  >SB</text>
</svg>
