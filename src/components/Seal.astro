---
// The site's signature motif — a small frosted-glass "wax seal" medallion.
// Used for blog categories and project status, nowhere else. Keep it rare:
// one per card, never decorative filler.
interface Props {
  label: string;
  tone?: "pen" | "highlight" | "ink";
  class?: string;
}

const { label, tone = "pen", class: className = "" } = Astro.props;

// Initial shown inside the seal — first letter of the label reads cleanly
// at this size, same way a real wax seal carries a single monogram.
const initial = label.trim().charAt(0).toUpperCase();

const toneClasses: Record<string, string> = {
  pen: "text-pen border-pen/40",
  highlight: "text-highlight border-highlight/60",
  ink: "text-ink-soft border-ink-soft/30",
};
---

<span class:list={["inline-flex items-center gap-2 -rotate-1 select-none", className]}>
  <span
    class:list={[
      "glass inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full",
      "font-display italic text-[0.7rem] font-semibold",
      toneClasses[tone],
    ]}
    aria-hidden="true"
  >
    {initial}
  </span>
  <span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-ink-soft">
    {label}
  </span>
</span>
