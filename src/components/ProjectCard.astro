---
import type { CollectionEntry } from "astro:content";
import StatusChip from "./StatusChip.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, status, featured, links } = project.data;
const { demo, repo } = links;

const statusTone: Record<string, "pen" | "highlight" | "ink"> = {
  live: "pen",
  prototype: "highlight",
  archived: "ink",
};
const tone = statusTone[status] ?? "ink";
const edgeVar: Record<string, string> = {
  pen: "var(--color-pen)",
  highlight: "var(--color-highlight)",
  ink: "var(--color-ink-soft)",
};
---

<div
  class="group card-edge panel relative flex flex-col h-full p-6 sm:p-7 hover:border-pen/50 transition-colors"
  style={`--edge: ${edgeVar[tone]}`}
>
  <div class="flex items-center justify-between gap-3 mb-4">
    <StatusChip label={status} tone={tone} />
    <div class="flex items-center gap-2">
      <span class="font-mono text-[0.65rem] text-ink-soft">
        {new Date(project.data.startDate).getFullYear()}
      </span>
      {featured && (
        <span class="inline-flex items-center gap-1" title="Featured">
          <span class="h-2 w-2 rounded-[1.5px] bg-pen" aria-hidden="true" />
          <span class="sr-only">Featured</span>
        </span>
      )}
    </div>
  </div>

  <h3 class="font-display font-semibold text-xl leading-snug text-ink group-hover:text-pen transition-colors">
    <a href={`/projects/${project.id}`} class="static after:absolute after:inset-0">
      {title}
    </a>
  </h3>
  <p class="mt-2 text-sm text-ink-soft leading-relaxed">{summary}</p>

  {(demo || repo) && (
    <div class="relative z-10 mt-auto pt-4 flex flex-wrap gap-4">
      {demo && (
        <a
          href={demo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-pen hover:text-ink transition-colors"
        >
          Live demo ↗
        </a>
      )}
      {repo && (
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-pen hover:text-ink transition-colors"
        >
          Source ↗
        </a>
      )}
    </div>
  )}
</div>
