---
import type { CollectionEntry } from "astro:content";
import Stamp from "./Stamp.astro";
import Seal from "./Seal.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, status, stack, featured } = project.data;

const statusTone: Record<string, "pen" | "highlight" | "ink"> = {
  live: "pen",
  prototype: "highlight",
  archived: "ink",
};
---

<a
  href={`/projects/${project.id}`}
  class="group glass flex flex-col h-full rounded-2xl p-6 sm:p-7 hover:bg-paper/75 transition-colors"
>
  <div class="flex items-center justify-between gap-3 mb-4">
    <Stamp label={status} tone={statusTone[status] ?? "ink"} />
    <div class="flex items-center gap-2">
      <span class="font-mono text-[0.65rem] text-ink-soft">
        {new Date(project.data.startDate).getFullYear()}
      </span>
      {featured && <Seal size={20} tone="pen" />}
      {featured && <span class="sr-only">Featured</span>}
    </div>
  </div>

  <h3 class="font-display text-xl leading-snug text-ink group-hover:text-pen transition-colors">
    {title}
  </h3>
  <p class="mt-2 text-sm text-ink-soft leading-relaxed">{summary}</p>

  <ul class="mt-auto pt-4 flex flex-wrap gap-1.5">
    {stack.slice(0, 4).map((item) => (
      <li class="font-mono text-[0.65rem] text-ink-soft border border-line rounded-[3px] px-1.5 py-0.5 bg-paper/50">
        {item}
      </li>
    ))}
  </ul>
</a>
